{
  "name": "planlayici",
  "productName": "My to do",
  "version": "1.3.0",
  "private": true,
  "description": "My to do — öğrenciler için görev, rutin, ders programı ve not planlayıcısı.",
  "author": "My to do",
  "license": "UNLICENSED",
  "main": "electron/main.cjs",
  "scripts": {
    "build:web": "node scripts/build-web.mjs",
    "ios": "npm run build:web && npx cap sync ios && npx cap open ios",
    "android": "npm run build:web && npx cap sync android && npx cap open android",
    "sync": "npm run build:web && npx cap sync",
    "desktop": "npm run build:web && electron .",
    "dist:mac": "npm run build:web && electron-builder --mac",
    "dist:win": "npm run build:web && electron-builder --win",
    "dist:linux": "npm run build:web && electron-builder --linux",
    "mock": "node tools/mock-supabase.mjs",
    "test:electron": "node --test electron/serve.test.cjs"
  },
  "devDependencies": {
    "@capacitor/android": "8.5.3",
    "@capacitor/cli": "8.5.3",
    "@capacitor/core": "8.5.3",
    "@capacitor/filesystem": "8.1.4",
    "@capacitor/ios": "8.5.3",
    "@capacitor/local-notifications": "8.3.1",
    "@capacitor/share": "8.0.3",
    "@capacitor/status-bar": "8.0.4",
    "electron": "44.7.2",
    "electron-builder": "26.15.3"
  },
  "engines": {
    "node": ">=22"
  },
  "build": {
    "appId": "com.planlayici.app",
    "productName": "My to do",
    "artifactName": "MyToDo-${version}-${os}-${arch}.${ext}",
    "directories": {
      "output": "release",
      "buildResources": "build"
    },
    "files": [
      "electron/**/*",
      "!electron/*.test.cjs",
      "www/**/*",
      "build/icon.png",
      "package.json"
    ],
    "asar": true,
    "mac": {
      "category": "public.app-category.productivity",
      "target": [
        {
          "target": "dmg",
          "arch": [
            "universal"
          ]
        }
      ],
      "identity": "-",
      "hardenedRuntime": false,
      "darkModeSupport": true
    },
    "dmg": {
      "title": "My to do ${version}"
    },
    "win": {
      "target": [
        {
          "target": "nsis",
          "arch": [
            "x64",
            "arm64"
          ]
        }
      ]
    },
    "nsis": {
      "oneClick": false,
      "perMachine": false,
      "allowToChangeInstallationDirectory": true,
      "createDesktopShortcut": true,
      "shortcutName": "My to do",
      "installerLanguages": [
        "tr_TR"
      ],
      "language": "1055"
    },
    "linux": {
      "target": [
        "AppImage"
      ],
      "category": "Office"
    }
  }
}
